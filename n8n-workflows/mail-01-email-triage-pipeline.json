      "id": "2d2e81da-9d76-4ae1-abce-1d6beedb6eaf",
      "name": "Gmail Message Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst headers = item.headers || {};\nconst labels = item.labelIds || [];\n\n// Idempotency check: Skip if already processed by AI\nif (labels.includes('AI-Processed') || labels.includes('AI-Drafted')) {\n  return null; // Ignore already processed message\n}\n\nconst authResults = (headers['authentication-results'] || '').toLowerCase();\nconst listUnsubscribe = headers['list-unsubscribe'] || '';\nconst precedence = (headers['precedence'] || '').toLowerCase();\nconst autoSubmitted = (headers['auto-submitted'] || '').toLowerCase();\n\nconst fromAddress = item.from || headers['from'] || '';\nconst subject = item.subject || headers['subject'] || '(No Subject)';\nconst messageId = item.id || item.messageId || ('msg_' + Date.now());\nconst threadId = item.threadId || item.id || messageId;\nconst body = item.textPlain || item.snippet || '';\n\n// Clean domain extraction\nconst domainMatch = fromAddress.match(/@([a-zA-Z0-9.-]+\\.[a-zA-Z]{2,})/);\nconst senderDomain = domainMatch ? domainMatch[1].toLowerCase() : '';\n\n// Attachments metadata extraction\nconst rawAttachments = item.attachments || [];\nconst attachmentsMeta = rawAttachments.map(a => ({\n  name: a.name || 'attachment',\n  mimeType: a.mimeType || 'application/octet-stream',\n  size: a.size || 0,\n  isPdf: (a.mimeType === 'application/pdf' || (a.name && a.name.toLowerCase().endsWith('.pdf'))),\n  isImage: (a.mimeType && a.mimeType.startsWith('image/'))\n}));\n\nconst hasPdf = attachmentsMeta.some(a => a.isPdf);\nconst hasImages = attachmentsMeta.some(a => a.isImage);\n\n// Sanitize body and strip quoted email replies\nconst sanitizedBody = body\n  .replace(/<[^>]*>?/gm, '')\n  .replace(/On\\s.+wrote:[\\s\\S]*/g, '')\n  .replace(/---+\\s*Original Message\\s*---+[\\s\\S]*/gi, '')\n  .substring(0, 4000)\n  .trim();\n\nreturn {\n  json: {\n    message_id: messageId,\n    thread_id: threadId,\n    from: fromAddress,\n    sender_domain: senderDomain,\n    subject: subject,\n    body_sanitized: sanitizedBody,\n    auth_results: authResults,\n    list_unsubscribe: listUnsubscribe,\n    precedence: precedence,\n    auto_submitted: autoSubmitted,\n    attachments_meta: attachmentsMeta,\n    has_pdf: hasPdf,\n    has_images: hasImages,\n    started_at: Date.now()\n  }\n};"
      },
      "id": "6813b073-27b8-4b90-a2a8-5ecede192b69",
      "name": "Extract Context & Headers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nlet preFiltered = false;\nlet category = null;\nlet reason = '';\nlet isVerifiedBill = false;\nlet isAuthWarning = false;\nlet isNewsletter = false;\n\n// Allowlist of verified SaaS & utility billing providers\nconst knownBillingDomains = [\n  'aws.amazon.com', 'stripe.com', 'slack.com', 'digitalocean.com',\n  'cloudflare.com', 'google.com', 'github.com', 'openai.com',\n  'adobe.com', 'microsoft.com', 'hubspot.com', 'resend.com'\n];\n\n// PRIORITY 1: Authenticated Known Billing Providers with PDF (Evaluated FIRST!)\nconst isKnownBillingDomain = knownBillingDomains.some(d => item.sender_domain.endsWith(d));\nconst passesAuth = (item.auth_results.includes('spf=pass') || item.auth_results.includes('dkim=pass'));\n\nif (isKnownBillingDomain && passesAuth && item.has_pdf) {\n  preFiltered = true;\n  category = 'bills_verified';\n  isVerifiedBill = true;\n  reason = `Verified invoice from authenticated billing partner (${item.sender_domain})`;\n}\n\n// PRIORITY 2: SPF / DKIM Authentication Failures (Flag for review, DO NOT silently delete)\nelse if (item.auth_results.includes('spf=fail') || item.auth_results.includes('dkim=fail')) {\n  preFiltered = true;\n  category = 'auth_warning';\n  isAuthWarning = true;\n  reason = 'Authentication check failed (SPF/DKIM fail). Flagged for inspection without auto-archive.';\n}\n\n// PRIORITY 3: Marketing Newsletters (Label AI-Newsletter, DO NOT auto-archive)\nelse if (item.list_unsubscribe && (item.precedence === 'bulk' || item.precedence === 'list')) {\n  preFiltered = true;\n  category = 'newsletter';\n  isNewsletter = true;\n  reason = 'Marketing newsletter detected via bulk headers. Labeling as AI-Newsletter.';\n}\n\nreturn {\n  json: {\n    ...item,\n    pre_filtered: preFiltered,\n    category: category,\n    reason: reason,\n    is_verified_bill: isVerifiedBill,\n    is_auth_warning: isAuthWarning,\n    is_newsletter: isNewsletter,\n    requires_draft: false,\n    confidence: preFiltered ? 1.0 : 0.0,\n    draft_reply: ''\n  }\n};"
      },
      "id": "c350f2d9-8227-4ceb-a790-6409b1d196cb",
      "name": "Prioritized Pre-Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
