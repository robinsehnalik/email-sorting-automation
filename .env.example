# ==============================================================================
# Email Triage Automation — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure credentials before deploying workflows.
# Never commit actual secret keys or API tokens to version control.
# ==============================================================================

# --- LLM API Configuration ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# --- n8n Instance Configuration ---
LINK_TO_YOUR_N8N_INSTANCE=https://n8n.yourcompany.com

# --- Outbound Webhook Security ---
BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
CRM_WEBHOOK_SECRET=crm_sec_xxxxxxxxxxxxxxxxxxxxxxxx
LINK_TO_YOUR_CRM_OR_LEAD_WEBHOOK=https://crm.yourcompany.com/webhook/lead-intake

# --- Telemetry & Analytics (Supabase) ---
LINK_TO_YOUR_SUPABASE_URL=https://xyzproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsIn...

# --- Administrative Alerting ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SYSTEM_SENDER_EMAIL=alerts@yourcompany.com
ADMIN_NOTIFICATION_EMAIL=admin@yourcompany.com
